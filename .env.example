# Variáveis de ambiente do Radar MLBB (backend zero-dep — NÃO há carregamento
# automático de .env: exporte no processo/shell antes de subir a API).
#
# PowerShell:  $env:PORT = "3001"; node apps/api/src/index.js
# Bash:        PORT=3001 node apps/api/src/index.js

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Porta do servidor (apps/api/src/index.js). Default: 3001.
PORT=3001

# ── Fonte externa (Rone Arena API) ────────────────────────────────────────────
# Base do upstream. Default: https://arena.fastapicloud.dev
ARENA_BASE=https://arena.fastapicloud.dev

# Allowlist de hosts de failover, separados por vírgula. VAZIO = sem failover
# (só o próprio ARENA_BASE é aceito). O header `x-alt-host` do upstream só é
# seguido se o origin estiver nesta lista (proteção contra redirecionamento
# arbitrário — arena.js).
ARENA_ALT_HOSTS=

# Concorrência do fan-out de páginas/coleta (arena.mapConc). Default: 4.
ARENA_CONC=4

# ── Cache / histórico ─────────────────────────────────────────────────────────
# on  = SQLite (node:sqlite) + fallback memória. off = somente memória volátil.
SQLITE_CACHE=on

# Caminho do SQLite. É RELATIVO AO CWD do processo se não for absoluto — suba a
# API sempre da raiz do repo para não criar bancos paralelos.
SQLITE_FILE=./data/cache.sqlite
