# Variáveis de ambiente do Radar MLBB (backend zero-dep — NÃO há carregamento
# automático de .env: exporte no processo/shell antes de subir a API).
#
# PowerShell:  $env:PORT = "3001"; node app/api/src/index.js
# Bash:        PORT=3001 node app/api/src/index.js

# ── HTTP ──────────────────────────────────────────────────────────────────────
# Porta do servidor (app/api/src/index.js). Default: 3001.
PORT=3001

# ── Fonte externa (Rone Arena API) ────────────────────────────────────────────
# Base do upstream. Default: https://arena.fastapicloud.dev
ARENA_BASE=https://arena.fastapicloud.dev

# Allowlist de hosts de failover, separados por vírgula. VAZIO = sem failover
# (só o próprio ARENA_BASE é aceito). O header `x-alt-host` do upstream só é
# seguido se o origin estiver nesta lista (proteção contra redirecionamento
# arbitrário — arena.js).
ARENA_ALT_HOSTS=

# Concorrência do fan-out de páginas/coleta (arena.mapConc). Default: 4.
ARENA_CONC=4

# ── Dados persistentes (F3 / ADR-035) ─────────────────────────────────────────
# Raiz de TODO estado local (SQLite). Se relativo, é relativo à RAIZ DO REPO —
# não ao CWD. Default: <repo>/data.
DATA_DIR=./data

# ── Cache ─────────────────────────────────────────────────────────────────────
# on  = SQLite (node:sqlite) + fallback memória. off = somente memória volátil.
SQLITE_CACHE=on

# Override do arquivo SQLite. Omitido = $DATA_DIR/cache.sqlite. Se definido e
# relativo, é relativo ao CWD (compatibilidade); prefira DATA_DIR.
# SQLITE_FILE=./data/cache.sqlite

# ── Operação (F2 / ADR-034) ───────────────────────────────────────────────────
# Toda variável abaixo é validada por app/api/src/config.js no boot: valor
# inválido derruba o processo com mensagem citando o nome (fail-fast).

# Pasta do build do web servida pela API. Default: app/web/dist. Relativo ao CWD.
# WEB_DIST=app/web/dist

# Nível de log JSON: silent | error | info | debug. Default: info.
LOG_LEVEL=info

# Confiar em X-Forwarded-For para identificar o cliente do rate limit.
# Só ligue atrás de um proxy conhecido — senão o header é forjável.
TRUST_PROXY=0

# Rate limit por IP (token bucket). Default: 20 req/s com burst de 60.
# RATE_LIMIT_OFF=1 desliga (ex.: testes de carga locais).
RATE_LIMIT_OFF=0
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=60

# Tempo máximo de shutdown gracioso antes de derrubar conexões pendentes (ms).
SHUTDOWN_TIMEOUT_MS=10000
